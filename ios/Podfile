# Disable Firebase SPM to prevent static/dynamic linkage conflicts
$RNFirebaseDisableSPM = true

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

use_frameworks! :linkage => :static

target 'MyShopApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_WARN_STRICT_PROTOTYPES'] = 'NO'
        config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        
        # 💡 Forcefully disable treating warnings as errors for all pods
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        cflags = config.build_settings['OTHER_CFLAGS']
        if cflags.is_a?(Array)
          config.build_settings['OTHER_CFLAGS'] = (cflags + ['-w']).uniq
        elsif cflags.is_a?(String)
          config.build_settings['OTHER_CFLAGS'] = "#{cflags} -w"
        else
          config.build_settings['OTHER_CFLAGS'] = '$(inherited) -w'
        end

        cxxflags = config.build_settings['OTHER_CPLUSPLUSFLAGS']
        if cxxflags.is_a?(Array)
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = (cxxflags + ['-w']).uniq
        elsif cxxflags.is_a?(String)
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{cxxflags} -w"
        else
          config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -w'
        end

        if config.name == 'Release'
          defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
          if defs.is_a?(Array)
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = (defs + ['NDEBUG=1', 'REACT_NATIVE_PRODUCTION=1']).uniq
          elsif defs.is_a?(String)
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = "#{defs} NDEBUG=1 REACT_NATIVE_PRODUCTION=1"
          else
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = ['$(inherited)', 'NDEBUG=1', 'REACT_NATIVE_PRODUCTION=1']
          end
        end
      end
    end
  end
end